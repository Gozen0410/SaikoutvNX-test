<brls:Box width="auto" height="auto" axis="column" paddingTop="26" paddingBottom="22" paddingLeft="44" paddingRight="44" backgroundColor="#10141D">
    <brls:Box width="auto" height="58" axis="row" alignItems="center" justifyContent="spaceBetween">
        <brls:Label width="auto" height="auto" text="SAIKOU TV" fontSize="31" textColor="#F4F6FA" />
        <brls:Box width="auto" height="58" axis="row" alignItems="center">
            <brls:Label id="nav/home" width="auto" height="auto" text="HOME" fontSize="16" marginRight="26" focusable="true" />
            <brls:Label id="nav/search" width="auto" height="auto" text="SEARCH" fontSize="16" marginRight="26" focusable="true" />
            <brls:Label id="nav/library" width="auto" height="auto" text="LIBRARY" fontSize="16" marginRight="26" focusable="true" />
            <brls:Label id="nav/settings" width="auto" height="auto" text="SETTINGS" fontSize="16" focusable="true" />
        </brls:Box>
    </brls:Box>

    <brls:Box width="auto" height="2" marginTop="9" marginBottom="12" backgroundColor="#2A3240" />

    <brls:ScrollingFrame id="home/content/scroll" width="auto" height="570" marginTop="4" scrollingBehavior="centered">
        <brls:Box id="home/content" width="1160" height="1080" axis="column">
            <brls:Label id="home/status" width="auto" height="auto" text="Connecting to AniList..." fontSize="14" textColor="#AEB8C8" />
            <brls:Label width="auto" height="auto" text="Welcome back" fontSize="34" marginTop="7" textColor="#F4F6FA" />
            <brls:Label width="auto" height="auto" text="Anime discovery, powered by AniList." fontSize="17" marginTop="2" textColor="#AEB8C8" />

            <brls:Box width="auto" height="28" axis="row" alignItems="center" justifyContent="spaceBetween" marginTop="18">
                <brls:Label width="auto" height="auto" text="CONTINUE WATCHING" fontSize="19" textColor="#DCE4F0" />
                <brls:Label id="home/continue/subtitle" width="auto" height="auto" text="Watch progress" fontSize="13" textColor="#8793A6" />
            </brls:Box>
            <brls:HScrollingFrame id="home/continue/scroll" width="auto" height="260" marginTop="5" scrollingBehavior="centered">
                <brls:Box id="home/card/continue" width="4760" height="260" axis="row" />
            </brls:HScrollingFrame>

            <brls:Box width="auto" height="28" axis="row" alignItems="center" justifyContent="spaceBetween" marginTop="14">
                <brls:Label width="auto" height="auto" text="TRENDING" fontSize="19" textColor="#DCE4F0" />
                <brls:Label width="auto" height="auto" text="Live AniList trending titles" fontSize="13" textColor="#8793A6" />
            </brls:Box>
            <brls:HScrollingFrame id="home/trending/scroll" width="auto" height="260" marginTop="5" scrollingBehavior="natural">
                <brls:Box id="home/trending/cards" width="4760" height="260" axis="row" />
            </brls:HScrollingFrame>

            <brls:Box width="auto" height="28" axis="row" alignItems="center" justifyContent="spaceBetween" marginTop="18">
                <brls:Label width="auto" height="auto" text="CURRENTLY AIRING" fontSize="19" textColor="#DCE4F0" />
                <brls:Label width="auto" height="auto" text="Currently releasing on AniList" fontSize="13" textColor="#8793A6" />
            </brls:Box>
            <brls:HScrollingFrame id="home/latest/scroll" width="auto" height="260" marginTop="5" scrollingBehavior="natural">
                <brls:Box id="home/latest/cards" width="4760" height="260" axis="row" />
            </brls:HScrollingFrame>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
